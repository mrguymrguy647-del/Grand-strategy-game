/* Grand Strategy - interface theme.
   Dark steel panels with gold trim. Loaded by HudController from Resources/UI/Game.
   Fonts are applied from code (Ui.cs) so they work with any UI Toolkit theme. */

/* ---------------------------------------------------------------- base */

.gs-root {
    color: rgb(230, 233, 238);
    font-size: 15px;
}

.gs-text {
    color: rgb(230, 233, 238);
    margin: 0;
    padding: 0;
    white-space: normal;
}

.gs-dim {
    color: rgb(150, 160, 176);
}

.gs-gold {
    color: rgb(226, 188, 104);
}

.gs-good {
    color: rgb(126, 212, 136);
}

.gs-bad {
    color: rgb(240, 116, 104);
}

.gs-warn {
    color: rgb(242, 196, 92);
}

.gs-title {
    font-size: 26px;
    color: rgb(244, 238, 222);
    margin: 0;
    padding: 0;
}

.gs-section-title {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: rgb(226, 188, 104);
    margin-top: 14px;
    margin-bottom: 6px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(226, 188, 104, 0.25);
}

.gs-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgb(226, 188, 104);
}

.gs-icon--white {
    -unity-background-image-tint-color: rgb(236, 238, 242);
}

.gs-icon--large {
    width: 44px;
    height: 44px;
}

.gs-flag {
    width: 48px;
    height: 36px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.7);
    border-radius: 2px;
}

.gs-flag--large {
    width: 84px;
    height: 63px;
}

.gs-flag--small {
    width: 24px;
    height: 18px;
}

/* ---------------------------------------------------------------- panels */

.gs-panel {
    background-image: resource("UI/Textures/panel");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: rgba(214, 176, 98, 0.38);
    border-radius: 6px;
}

.gs-panel__header {
    background-image: resource("UI/Textures/header");
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(214, 176, 98, 0.45);
}

.gs-panel__body {
    padding: 12px 14px;
}

.gs-card {
    background-color: rgba(255, 255, 255, 0.035);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.gs-card:hover {
    border-color: rgba(226, 188, 104, 0.35);
}

.gs-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    margin-top: 8px;
    margin-bottom: 8px;
}

/* ---------------------------------------------------------------- buttons */

.gs-btn {
    background-image: resource("UI/Textures/button");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    color: rgb(232, 235, 240);
    padding: 5px 12px;
    margin: 2px;
    -unity-text-align: middle-center;
    transition-property: border-color;
    transition-duration: 0.12s;
}

.gs-btn:hover {
    background-image: resource("UI/Textures/button_hover");
    border-color: rgba(226, 188, 104, 0.75);
}

.gs-btn:active {
    border-color: rgb(255, 222, 150);
}

.gs-btn:disabled {
    opacity: 0.4;
}

.gs-btn--primary {
    background-image: resource("UI/Textures/button_primary");
    border-color: rgb(240, 206, 128);
    color: rgb(28, 22, 10);
}

.gs-btn--primary:hover {
    background-image: resource("UI/Textures/button_primary_hover");
    border-color: rgb(255, 230, 170);
}

.gs-btn--icon {
    padding: 4px;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
}

.gs-btn--active {
    border-color: rgb(226, 188, 104);
    background-image: resource("UI/Textures/button_hover");
}

/* ---------------------------------------------------------------- top bar */

.gs-topbar {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 64px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-image: resource("UI/Textures/topbar");
    -unity-background-scale-mode: stretch-to-fill;
    border-bottom-width: 2px;
    border-bottom-color: rgba(214, 176, 98, 0.55);
}

.gs-chip {
    flex-direction: row;
    align-items: center;
    padding: 5px 10px;
    margin-right: 6px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.gs-chip:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border-color: rgba(226, 188, 104, 0.55);
}

.gs-chip__value {
    font-size: 17px;
    margin-left: 6px;
}

.gs-chip__delta {
    font-size: 13px;
    margin-left: 5px;
}

.gs-date {
    font-size: 20px;
    color: rgb(244, 238, 222);
    min-width: 170px;
    -unity-text-align: middle-right;
    margin-right: 10px;
}

.gs-pip {
    width: 7px;
    margin-left: 2px;
    border-radius: 2px;
    align-self: flex-end;
    background-color: rgba(255, 255, 255, 0.12);
}

.gs-pip--on {
    background-color: rgb(226, 188, 104);
}

.gs-pip--paused {
    background-color: rgb(140, 140, 140);
}

/* ---------------------------------------------------------------- tabs */

.gs-tabs {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: rgba(214, 176, 98, 0.35);
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(0, 0, 0, 0.25);
}

.gs-tab {
    flex-grow: 1;
    padding: 8px 4px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: rgb(150, 160, 176);
    -unity-text-align: middle-center;
}

.gs-tab:hover {
    color: rgb(236, 238, 242);
    background-color: rgba(255, 255, 255, 0.05);
}

.gs-tab--active {
    color: rgb(244, 226, 170);
    border-bottom-color: rgb(226, 188, 104);
}

/* ---------------------------------------------------------------- stats & bars */

.gs-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.gs-stat-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.gs-stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.gs-stat-card {
    width: 49%;
    background-color: rgba(255, 255, 255, 0.035);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    padding: 7px 9px;
    margin-bottom: 6px;
    flex-direction: row;
    align-items: center;
}

.gs-stat-card:hover {
    border-color: rgba(226, 188, 104, 0.45);
}

.gs-stat-card__label {
    font-size: 12px;
    color: rgb(150, 160, 176);
}

.gs-stat-card__value {
    font-size: 18px;
    color: rgb(240, 242, 246);
}

.gs-bar {
    height: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    overflow: hidden;
    margin-top: 4px;
}

.gs-bar__fill {
    height: 100%;
    border-radius: 4px;
    background-color: rgb(226, 188, 104);
}

.gs-bar__marker {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.85);
}

/* ---------------------------------------------------------------- tooltip */

.gs-tooltip {
    position: absolute;
    background-color: rgba(8, 11, 17, 0.97);
    border-width: 1px;
    border-color: rgba(214, 176, 98, 0.6);
    border-radius: 5px;
    padding: 9px 11px;
    max-width: 380px;
    min-width: 180px;
}

.gs-tooltip__title {
    font-size: 16px;
    color: rgb(244, 226, 170);
    margin-bottom: 4px;
}

.gs-tooltip__row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 1px;
    padding-bottom: 1px;
}

.gs-tooltip__total {
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
    margin-top: 4px;
    padding-top: 4px;
}

/* ---------------------------------------------------------------- modals */

.gs-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.gs-option {
    background-image: resource("UI/Textures/button");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 5px;
    padding: 9px 12px;
    margin-top: 6px;
    flex-direction: column;
    align-items: flex-start;
}

.gs-option:hover {
    background-image: resource("UI/Textures/button_hover");
    border-color: rgba(226, 188, 104, 0.8);
}

/* ---------------------------------------------------------------- news */

.gs-news {
    padding: 6px 8px;
    margin-bottom: 4px;
    border-left-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 3px;
}

.gs-news:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.gs-news--player {
    border-left-color: rgb(226, 188, 104);
    background-color: rgba(226, 188, 104, 0.08);
}

.gs-news--notable {
    border-left-color: rgba(120, 170, 230, 0.8);
}

/* ---------------------------------------------------------------- sliders */

.gs-slider-row {
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.gs-slider-row .unity-base-slider__dragger {
    background-color: rgb(226, 188, 104);
    border-color: rgb(255, 230, 170);
    border-radius: 3px;
}

.gs-slider-row .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
}

.gs-slider-row .unity-base-field__label {
    min-width: 0;
    width: 0;
    display: none;
}
