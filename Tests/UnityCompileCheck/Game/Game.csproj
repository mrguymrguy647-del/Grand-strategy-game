<Project Sdk="Microsoft.NET.Sdk">
  <!-- GrandStrategy.Game.asmdef: references GrandStrategy.Simulation (and the Input System when installed). -->
  <PropertyGroup>
    <AssemblyName>GrandStrategy.Game</AssemblyName>
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER;UNITY_2021_3_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ScriptsDir)Game/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Simulation/Simulation.csproj" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
  </ItemGroup>
</Project>
